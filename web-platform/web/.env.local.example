# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# Supabase project URL and anon (public) key — from Project Settings > API.
# Safe to expose to the browser: RLS is the actual security boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import
# this from a Client Component, never send it to the browser. Used only in
# server actions / route handlers that need to bypass RLS for privileged
# admin operations (creating auth users, resetting passwords, etc.).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
