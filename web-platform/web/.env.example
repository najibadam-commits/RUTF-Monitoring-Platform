# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# Never commit .env.local — it holds real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security entirely — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build links in auth emails (password reset, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
