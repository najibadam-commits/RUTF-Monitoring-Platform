# Copy to .env and fill in. Used only by the one-off scripts in this folder
# (migrate.js, apply-one.js, seed-demo.js, etc.) — never commit .env.

# Session Pooler connection string (Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> URI -> Session pooler). The direct
# db.<ref>.supabase.co host is IPv6-only on most networks; the pooler works
# over IPv4.
DATABASE_URL=

# Same values as web/.env.example — used by seed-demo.js to create demo
# accounts via the Admin API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
